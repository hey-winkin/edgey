{
  "name": "edgey-storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "tokens": "node scripts/build-tokens.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:env": "node scripts/write-env.mjs",
    "db:fixture": "node scripts/apply-staging-fixture.mjs",
    "catalogue:sync": "node scripts/sync-catalogue.mjs",
    "demo:orders": "node scripts/demo-orders.mjs load",
    "demo:orders:clean": "node scripts/demo-orders.mjs clean",
    "test": "vitest run tests/unit src/lib/commerce",
    "bench:search": "node scripts/bench-search.mjs",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "test:acceptance": "node scripts/test-acceptance.mjs",
    "staging:check": "node scripts/check-staging.mjs",
    "db:fixture:staging": "node scripts/apply-hosted-staging-fixture.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "23.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "postcss": "8.5.33",
    "supabase": "3.2.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "unpdf": "2.2.1",
    "vitest": "5.1.1"
  }
}
